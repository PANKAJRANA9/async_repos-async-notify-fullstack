{
  "title": "AsyncNotify - Enterprise Dashboard",
  "uid": "async-notify",
  "tags": [
    "async-notify",
    "rabbitmq",
    "prometheus"
  ],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Sent Total",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "async_notify_sent_total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Dedup Total (Spam Prevented)",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "async_notify_dedup_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Retry Total",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "async_notify_retry_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "DLQ Total",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "async_notify_dlq_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Outbox Pending",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "async_notify_outbox_pending",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "JVM Memory Used",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Sent Rate (per min)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "rate(async_notify_sent_total[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "HTTP Requests",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count[5m])",
          "refId": "A"
        }
      ]
    }
  ]
}